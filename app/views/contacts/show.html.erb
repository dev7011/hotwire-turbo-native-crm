<div class="mx-auto max-w-3xl p-8">

  <h1 class="mb-6 text-3xl font-bold">
    <%= @contact.first_name %>
    <%= @contact.last_name %>
  </h1>

  <div class="rounded-xl border bg-white p-6 space-y-4">

    <p>
      <strong>Company:</strong>
      <%= link_to @contact.company.name,
                  company_path(@contact.company) %>
    </p>

    <p>
      <strong>Email:</strong>
      <%= @contact.email %>
    </p>

    <p>
      <strong>Phone:</strong>
      <%= @contact.phone %>
    </p>

    <p>
      <strong>Position:</strong>
      <%= @contact.position %>
    </p>

  </div>

  <%= link_to "Edit",
              edit_company_contact_path(@company, @contact),
              class: "mt-6 inline-block text-blue-600" %>

</div>