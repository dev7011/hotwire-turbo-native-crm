<div class="mx-auto max-w-6xl p-8">
  <div class="mb-8 flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold">Contacts</h1>
      <p class="mt-1 text-gray-500"><%= @company.name %></p>
    </div>

    <%= create_turbo_link("New Contact", new_company_contact_path(@company), turbo_frame: "contact_button_new") %>
  </div>

  <%= turbo_frame_tag "contact_form" %>

  <div class="overflow-hidden rounded-xl border bg-white">
    <table class="w-full text-left">
      <thead class="bg-gray-100">
      <tr>
        <th class="p-4">Name</th>
        <th class="p-4">Position</th>
        <th class="p-4">Email</th>
        <th class="p-4">Actions</th>
      </tr>
      </thead>

      <tbody id="contact_rows">
        <%= render @contacts %>
      </tbody>

    </table>

    <% if @contacts.empty? %>
      <p class="p-8 text-center text-gray-500">
        No contacts found.
      </p>
    <% end %>
  </div>

  <%= back_turbo_link("Back", company_path(@company)) %>

</div>