

<div class="mx-auto max-w-6xl p-4 sm:p-8">

  <div class="mb-6 flex items-center justify-between gap-3 sm:mb-8">
    <h1 class="text-2xl font-bold sm:text-3xl">
      Companies
    </h1>

    <%= turbo_frame_tag "company_button_new" do %>
      <%= create_turbo_link("New Company", new_company_path) %>
    <% end %>

  </div>

  <%= turbo_frame_tag "company_form" %>

  <% if @companies.empty? %>
    <p class="rounded-xl border p-8 text-center text-gray-500">
      No companies found.
    </p>
  <% else %>

    <%# Mobile: Card layout %>
    <div class="space-y-3 md:hidden" id="company_mobile">
      <%= render partial: "company_mobile", collection: @companies, as: :company %>
    </div>

    <%# Desktop: Table layout %>
    <div class="hidden overflow-hidden rounded-xl border bg-white md:block">
      <table class="w-full text-left">
        <thead class="bg-gray-100">
        <tr>
          <th class="p-4">Company</th>
          <th class="p-4">Industry</th>
          <th class="p-4">Email</th>
          <th class="p-4">Actions</th>
        </tr>
        </thead>

        <tbody id="companies">
          <%= render @companies %>
        </tbody>
      </table>
    </div>

  <% end %>
</div>
