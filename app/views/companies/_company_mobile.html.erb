
<div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm"
     id="<%= dom_id(company, :mobile) %>">

  <div class="mb-3">
    <%= link_to company.name,
                company,
                class: "text-lg font-semibold text-blue-600 hover:underline break-words" %>
  </div>

  <div class="space-y-1 text-sm text-gray-600">
    <% if company.industry.present? %>
      <p>
        <span class="font-medium text-gray-800">Industry:</span>
        <%= company.industry %>
      </p>
    <% end %>

    <% if company.email.present? %>
      <p class="break-all">
        <span class="font-medium text-gray-800">Email:</span>
        <%= company.email %>
      </p>
    <% end %>
  </div>

  <div class="mt-4 flex items-center gap-5 border-t pt-3">
    <%= link_to "Edit",
                edit_company_path(company),
                data: { turbo_stream: true },
                class: "font-medium text-blue-600" %>

    <%= button_to "Delete",
                  company_path(company),
                  method: :delete,
                  form: { class: "inline" },
                  data: { turbo_confirm: "Are you sure?" },
                  class: "font-medium text-red-600" %>
  </div>
</div>
