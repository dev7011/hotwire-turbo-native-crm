<div class="mx-auto max-w-6xl p-8">

  <h1 class="mb-2 text-3xl font-bold">
    CRM Dashboard
  </h1>

  <p class="mb-8 text-gray-500">
    Welcome to your CRM system.
  </p>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">

    <div class="rounded-xl border bg-white p-6">
      <h2 class="text-gray-500">Companies</h2>

      <p class="mt-3 text-4xl font-bold">
        <%= Company.count %>
      </p>

      <%= link_to "View Companies",
                  companies_path,
                  class: "mt-4 inline-block text-blue-600" %>
    </div>

    <div class="rounded-xl border bg-white p-6">
      <h2 class="text-gray-500">Contacts</h2>

      <p class="mt-3 text-4xl font-bold">
        <%= Contact.count %>
      </p>

      <%= link_to "View Contacts",
                  dashboard_contacts_path,
                  class: "mt-4 inline-block text-blue-600" %>

    </div>

    <div class="rounded-xl border bg-white p-6">
      <h2 class="text-gray-500">Deals</h2>

      <p class="mt-3 text-4xl font-bold">
        <%= Deal.count %>
      </p>
    </div>

  </div>

</div>