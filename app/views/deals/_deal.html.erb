<tr id="<%= dom_id(deal) %>" class="border-t">

  <td class="p-4 font-medium">
    <%= link_to deal.title,
                deal,
                class: "text-blue-600 hover:underline" %>
  </td>

  <td class="p-4">
    <%= deal.company.name %>
  </td>

  <td class="p-4">
    <%= deal.contact.try(:first_name) %>
  </td>

  <td class="p-4">
    <%= number_to_currency(deal.value, unit: "€", separator: ",", delimiter: ".") %>
  </td>

  <td class="p-4">
    <%= deal.stage.humanize %>
  </td>

  <td class="space-x-3 p-4">
    <%= link_to "Edit",
                edit_deal_path(deal),
                class: "text-blue-600" %>

    <%= button_to "Delete",
                  deal_path(deal),
                  method: :delete,
                  data: { turbo_confirm: "Are you sure?" },
                  class: "text-red-600" %>
  </td>

</tr>