<div class="mx-auto max-w-3xl p-8">

  <h1 class="mb-6 text-3xl font-bold">
    <%= @deal.title %>
  </h1>

  <div class="space-y-4 rounded-xl border bg-white p-6">

    <p>
      <strong>Company:</strong>
      <%= @deal.company.name %>
    </p>

    <p>
      <strong>Contact:</strong>
      <%= @deal.contact.try(:first_name) %>
    </p>

    <p>
      <strong>Value:</strong>
      <%= number_to_currency(@deal.value, unit: "€") %>
    </p>

    <p>
      <strong>Stage:</strong>
      <%= @deal.stage.humanize %>
    </p>

  </div>

  <div class="mt-6 flex gap-4">
    <%= link_to "Edit", edit_deal_path(@deal) %>
    <%= link_to "Back", deals_path %>
  </div>

</div>